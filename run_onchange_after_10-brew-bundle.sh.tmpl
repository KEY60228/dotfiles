#!/bin/sh
set -eu

{{ if eq .chezmoi.os "darwin" -}}
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

# Brewfile hash: {{ include "dot_Brewfile.tmpl" | sha256sum }}
# Install first, then clean up: `brew bundle` grants trust from the
# Brewfile's `trusted: true` options before loading third-party tap
# formulae, whereas a standalone `brew bundle cleanup` loads them
# before syncing the trust store and fails on untrusted taps.
brew bundle --global --verbose --force --force-cleanup
{{ end -}}
